{
  "id": "ptz-rcp",
  "name": "RCP",
  "system": "ptz",
  "bindings": [
    {
      "control": "knob",
      "held": [],
      "turn": {
        "action": "ptz.step",
        "op": "iris",
        "target": "selected",
        "velocity": true
      },
      "press": {
        "action": "ptz.toggle",
        "op": "irisMode",
        "target": "selected"
      },
      "long": {
        "action": "ptz.reset",
        "op": "iris",
        "target": "selected",
        "liveGuard": "exposure"
      }
    },
    {
      "control": "dial",
      "held": [],
      "turn": {
        "action": "ptz.step",
        "op": "masterPed",
        "target": "selected",
        "velocity": true
      },
      "press": {
        "action": "ptz.dialPair",
        "ops": [
          "masterPed",
          "pictureLevel"
        ],
        "target": "selected"
      },
      "long": {
        "action": "ptz.resetActiveDial",
        "target": "selected"
      }
    },
    {
      "control": "scroll",
      "held": [],
      "turn": {
        "action": "ptz.rate",
        "axis": "zoom",
        "target": "selected"
      },
      "press": {
        "action": "ptz.oneTouchAF",
        "target": "selected"
      },
      "long": {
        "action": "ptz.toggle",
        "op": "focusMode",
        "target": "selected"
      }
    },
    {
      "control": "tour",
      "held": [],
      "press": {
        "action": "tourbox.profile",
        "profile": "ptz-msu"
      },
      "long": {
        "action": "ptz.stop",
        "target": "selected",
        "axes": [
          "pt",
          "zoom",
          "focus"
        ]
      }
    },
    {
      "control": "top",
      "held": [],
      "press": {
        "action": "tourbox.bank",
        "bank": "white"
      }
    },
    {
      "control": "tall",
      "held": [],
      "press": {
        "action": "tourbox.bank",
        "bank": "black"
      }
    },
    {
      "control": "short",
      "held": [],
      "press": {
        "action": "tourbox.bank",
        "bank": "tone"
      }
    },
    {
      "control": "up",
      "held": [],
      "press": {
        "action": "ptz.presetStep",
        "dir": -1,
        "target": "selected",
        "guarded": true
      }
    },
    {
      "control": "down",
      "held": [],
      "press": {
        "action": "ptz.presetStep",
        "dir": 1,
        "target": "selected",
        "guarded": true
      }
    },
    {
