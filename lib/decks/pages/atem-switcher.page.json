{
  "id": "atem-switcher",
  "surface": "plusxl",
  "cols": 9,
  "rows": 4,
  "keys": [
    { "id": "home", "element": "button", "role": "nav", "text": "HOME", "title": "PAGE", "actions": { "press": [{ "action": "nav.home" }] } },
    { "id": "info", "element": "button", "role": "info", "text": "$(atem:name)", "caption": "$(atem:ip)", "actions": { "press": [{ "action": "atem.info" }], "hold": [{ "action": "atem.config" }] } },
    { "id": "blank", "element": "button", "role": "blank", "text": "" },
    { "id": "tab-switcher", "element": "button", "role": "tab", "text": "SWITCHER", "title": "PAGE", "target": "atem-switcher", "actions": { "press": [{ "action": "nav.page", "options": { "page": "atem-switcher" } }] } },
    { "id": "tab-router", "element": "button", "role": "tab", "text": "ROUTER", "title": "AUX", "target": "atem-router", "actions": { "press": [{ "action": "nav.page", "options": { "page": "atem-router" } }] } },
    { "id": "tab-audio", "element": "button", "role": "tab", "text": "AUDIO", "title": "MIX", "target": "atem-audio", "actions": { "press": [{ "action": "nav.page", "options": { "page": "atem-audio" } }] } },
    { "id": "tab-keys", "element": "button", "role": "tab", "text": "KEYS/SS", "title": "PAGE", "target": "atem-keys", "actions": { "press": [{ "action": "nav.page", "options": { "page": "atem-keys" } }] } },
    { "id": "tab-mv", "element": "button", "role": "tab", "text": "MULTIVIEWER", "title": "PAGE", "target": "atem-mv", "actions": { "press": [{ "action": "nav.page", "options": { "page": "atem-mv" } }] } },
    { "id": "trans-select", "element": "button", "role": "toggle", "text": "TRANS", "title": "NEXT", "caption": "$(atem:armed)", "style": { "bar": "#C42020" }, "feedbacks": [{ "when": "transHold", "style": { "bgcolor": "#3a1012", "border": "#C42020" } }], "actions": { "hold": [{ "action": "atem.transSelect" }] } },
    { "repeat": 7, "id": "flex", "element": "button", "role": "flex", "slotFrom": 0 },
    { "id": "macro-shift", "element": "button", "role": "shift", "text": "MACRO", "title": "SHIFT", "caption": "$(atem:bankLabel)", "feedbacks": [{ "when": "bankOn", "style": { "bgcolor": "#E0B030", "color": "#1a1404" } }], "actions": { "press": [{ "action": "atem.flexBank", "options": { "banks": 4 } }] } },
    { "id": "cut", "element": "button", "role": "hot", "text": "CUT", "title": "ME", "feedbacks": [{ "when": "transition", "style": { "bgcolor": "#ff6b6b" } }], "actions": { "press": [{ "action": "atem.cut", "instance": "$(target)", "options": { "mes": "$(atem:mes)" } }] } },
    { "repeat": 8, "id": "pgm", "element": "button", "role": "program", "slotFrom": 1 },
    { "id": "trans", "element": "button", "role": "hot", "text": "TRANS", "title": "AUTO", "feedbacks": [{ "when": "transition", "style": { "bgcolor": "#ff6b6b" } }], "actions": { "press": [{ "action": "atem.auto", "instance": "$(target)", "options": { "mes": "$(atem:mes)" } }] } },
    { "repeat": 8, "id": "pvw", "element": "button", "role": "preview", "slotFrom": 1 },
    { "id": "shift", "element": "button", "role": "shift", "text": "SHIFT", "title": "MAP", "caption": "$(atem:shiftLabel)", "feedbacks": [{ "when": "shift", "style": { "bgcolor": "#E0B030", "color": "#1a1404" } }], "actions": { "press": [{ "action": "atem.shift" }] } }
  ],
  "encoders": [
    { "id": "me", "element": "encoder", "text": "M/E", "actions": { "turn": [{ "action": "atem.me" }] } },
    { "id": "effect", "element": "encoder", "text": "EFFECT", "actions": { "turn": [{ "action": "atem.effect" }] } },
    { "id": "wipe", "element": "encoder", "text": "WIPE", "actions": { "turn": [{ "action": "atem.wipe" }] } },
    { "id": "time", "element": "encoder", "text": "AUTO", "actions": { "turn": [{ "action": "atem.time" }] } },
    { "id": "tbar", "element": "encoder", "text": "T-BAR", "actions": { "turn": [{ "action": "atem.tbar" }] } },
    { "id": "map", "element": "encoder", "text": "MAP", "actions": { "turn": [{ "action": "atem.map" }] } }
  ]
}
