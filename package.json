{
  "name": "rs6-presets",
  "version": "0.35.0",
  "description": "Performance Video Control Center: one desk for RS6, E2, PixelHue, ATEM, Panasonic PTZ, Pixera and Millumin, with Path C Stream Deck pages and TSL tally on the ATEM page. Scopes is a separate app in apps/scopes.",
  "main": "server.js",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "start": "node server.js",
    "mock": "node server.js --mock",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@elgato-stream-deck/node": "7.8.0",
    "node-hid": "3.4.0",
    "@resvg/resvg-js": "2.6.2",
    "jpeg-js": "^0.4.4"
  },
  "optionalDependencies": {
    "@julusian/jpeg-turbo": "^3.1.0"
  },
  "allowScripts": {
    "node-hid@3.4.0": true,
    "@julusian/jpeg-turbo@3.1.0": true
  }
}
