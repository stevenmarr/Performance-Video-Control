[Unit]
Description=Performance Video Control Center
After=network-online.target
Wants=network-online.target

[Service]
# Type=simple on purpose. Type=notify waits for READY=1. Node cannot open
# systemd's notify socket (dgram is UDP only), so READY goes out through the
# systemd-notify program, which is a child. If that datagram never arrives,
# systemd fails the start with "a timeout was exceeded". Do not put
# WatchdogSec here. Turn the watchdog on with a drop-in if you want it.
# See the README, "Install / update on the Pi".
Type=simple
Restart=always
RestartSec=2
# The account that owns the show files. A drop-in can change this.
User=pi
# plugdev is the group on the Stream Deck hidraw nodes after the udev rule in
# tools/udev/50-control-center-streamdeck.rules is installed. systemd reads
# groups when the process starts. usermod does nothing to a process that is
# already running; restart the service after a group change.
# If `ls -l /dev/hidraw*` still shows group companion (Companion's rule locked
# the group), add companion in a drop-in and restart:
#   SupplementaryGroups=plugdev companion
# The companion group has to exist or systemd refuses to start (status 217/USER).
SupplementaryGroups=plugdev
WorkingDirectory=/opt/control-center
Environment=RS6_DATA_DIR=/var/lib/control-center
Environment=HOST=0.0.0.0
Environment=PORT=8088
# 8088, not 8080. On pvllc-pi2, 8080 is the UniFi Network controller,
# 8081 is File Browser, 8000 is Companion, and 8090 is the speaker timer.
ExecStart=/usr/bin/node server.js --host 0.0.0.0 --port 8088

[Install]
WantedBy=multi-user.target
